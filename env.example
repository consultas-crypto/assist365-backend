# Assist365 Backend — Variables de entorno
# Copiar este archivo como .env y completar los valores

# REQUERIDO: Clave de API de Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# REQUERIDO: Condiciones WTA (vouchers 365WT...)
DOCS_URL_WTA=https://docs.google.com/document/d/ID_DEL_DOC_WTA/pub?output=txt

# REQUERIDO: Condiciones WM (vouchers 365WM...)
DOCS_URL_WM=https://docs.google.com/document/d/ID_DEL_DOC_WM/pub?output=txt

# Puerto del servidor (default: 3000)
PORT=3000

# Orígenes permitidos (separados por coma)
ALLOWED_ORIGINS=https://tu-web-app.vercel.app,https://tuempresa.zendesk.com
